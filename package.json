{
  "name": "ternaryfox-sidebar",
  "version": "0.1.0",
  "description": "TernaryFox 终端 DSH 侧栏插件：原生 Tab 内嵌 Ternary agent（登录 / 话题 / 流式聊天），宿主半区提供 /tfapi 同源代理指向本地 tf-gateway。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ternaryfox",
    "sidebar"
  ],
  "license": "MIT"
}
